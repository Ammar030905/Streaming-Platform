# App
APP_ENV=production
APP_DEBUG=0
APP_URL=https://your-domain.com
APP_VERSION=1.0.0

# Supabase PostgreSQL (Settings > Database > Connection parameters)
DB_HOST=db.<your-project-ref>.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=<your-supabase-db-password>

# HLS streaming base URL
HLS_BASE_URL=https://your-stream-domain.com/hls
