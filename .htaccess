Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block access to sensitive files
    RewriteRule ^(config\.php|database\.sql|supabase_schema\.sql|\.env.*|render\.yaml|setup\.md)$ - [F,L]
</IfModule>

# Disable server signature
ServerSignature Off
